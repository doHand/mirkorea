# ─────────────────────────────────────────────────────────
# WMS Pro 백엔드 환경변수 예시
# 복사 후 .env 파일로 사용 (또는 Render 대시보드 > Environment에 직접 입력)
# ─────────────────────────────────────────────────────────

# JWT — 필수: openssl rand -hex 32 로 생성 (최소 32바이트)
JWT_SECRET=
JWT_EXPIRATION=3600          # 액세스 토큰 수명 (초) — 기본 1시간
JWT_REFRESH_EXPIRATION=604800 # 리프레시 토큰 수명 (초) — 기본 7일

# PostgreSQL (docker-compose.yml 로 로컬 실행 시 5433 포트로 매핑됨)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wms_pro_iizd
DB_USER=wms_user
DB_PASSWORD=wms123456
DB_SSL_MODE=prefer     # Render 프로덕션: require / 로컬 개발: disable 또는 prefer

# CORS — 프론트엔드 도메인 (콤마 구분 복수 허용)
CORS_ORIGINS=http://localhost:3000

# Swagger UI — 개발 환경에서만 true
SWAGGER_ENABLED=false

# 서버 포트
PORT=4000

APP_BASE_URL=https://your-domain.onrender.com
