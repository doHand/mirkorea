# =============================================================
# Render 프로덕션 환경변수 (Render 대시보드에서 직접 설정)
# =============================================================

# --- mirkorea-backend 서비스 ---
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME  → Render DB에서 자동 주입 (render.yaml 참고)
# JWT_SECRET=<Render에서 자동 생성>
# JWT_EXPIRATION=86400
# JWT_REFRESH_EXPIRATION=2592000
# CORS_ORIGINS=https://mirkorea-frontend.onrender.com

# --- mirkorea-frontend 서비스 ---
# NEXT_PUBLIC_API_URL=https://mirkorea-backend.onrender.com
